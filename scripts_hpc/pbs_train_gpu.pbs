#!/bin/bash
# ==============================================================================
# PBS Job Script: GPU Training on MANIT HPC (PBS Pro / Torque)
# ==============================================================================
#PBS -N emit_train_gpu
#PBS -q dgx
#PBS -l select=1:ncpus=10:ngpus=1:mem=32gb
#PBS -l place=free
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -o train_gpu.log

cd "$HOME/explainable-multimodal-HAR" || cd "$PBS_O_WORKDIR" || exit 1

LOG_FILE="$HOME/explainable-multimodal-HAR/train_gpu.log"
exec > >(tee -a "$LOG_FILE") 2>&1

echo "=========================================================="
echo "Starting Job: $PBS_JOBID on $(hostname) at $(date)"
echo "Working Directory: $(pwd)"
echo "=========================================================="

# 1. Load MANIT CUDA module
module load compilers/nvidia/cuda/11.6 2>/dev/null || true

# 2. Use direct Python interpreter from emit-har environment
PYTHON_BIN="$HOME/.conda/envs/emit-har/bin/python"
if [ ! -f "$PYTHON_BIN" ]; then
    PYTHON_BIN="$(which python)"
fi
echo "Using Python binary: $PYTHON_BIN"

# Verify Python & GPU availability
$PYTHON_BIN -c "import torch; print(f'PyTorch: {torch.__version__} | CUDA available: {torch.cuda.is_available()} | Device: {torch.cuda.get_device_name(0) if torch.cuda.is_available() else \"None\"}')"

export PYTHONUNBUFFERED=1
mkdir -p experiments/logs experiments/checkpoints experiments/results

# 3. Ensure multi-dataset processed sequences exist
if [ ! -d "data/processed/train" ] || [ -z "$(ls -A data/processed/train/*.npz 2>/dev/null)" ]; then
    echo "No processed sequences found. Generating unified multi-dataset sequences..."
    $PYTHON_BIN preprocess_multidataset.py
fi

echo "Sequence count in data/processed/train: $(ls -1 data/processed/train/*.npz 2>/dev/null | wc -l)"

# 4. Run Real Multimodal Training
echo "Starting model training..."
$PYTHON_BIN train.py \
    --config configs/config.yaml \
    --model proposed \
    --epochs 50 \
    --batch_size 16 \
    --lr 0.0001

echo "Job finished successfully at $(date)"

