#!/bin/bash
# ==============================================================================
# PBS Job Script: GPU Training on MANIT HPC (PBS Pro / Torque)
# ==============================================================================
#PBS -N emit_train_gpu
#PBS -q dgx
#PBS -o experiments/logs/train_gpu.out
#PBS -e experiments/logs/train_gpu.err
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l walltime=24:00:00

cd $PBS_O_WORKDIR

echo "=========================================================="
echo "Starting Job: $PBS_JOBID on $(hostname) at $(date)"
echo "=========================================================="

# 1. Load MANIT Modules
module purge 2>/dev/null || true
module load compilers/nvidia/cuda/11.6 2>/dev/null || true
module load apps/anaconda-2024.02 2>/dev/null || module load apps/anaconda3 2>/dev/null || true

# 2. Activate Conda Environment
source $(dirname $(dirname $(which python3)))/etc/profile.d/conda.sh 2>/dev/null || true
conda activate emit-har 2>/dev/null || source activate emit-har

# 3. Create log directory
mkdir -p experiments/logs experiments/checkpoints experiments/results

# 4. Run Training
python train.py \
    --config configs/config.yaml \
    --model proposed \
    --synthetic \
    --epochs 50 \
    --batch_size 16 \
    --lr 0.0001

echo "Job finished at $(date)"
