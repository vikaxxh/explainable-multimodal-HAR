#!/bin/bash
# ==============================================================================
# PBS Job Script: GPU Training on MANIT HPC (PBS Pro / Torque)
# ==============================================================================
#PBS -N emit_train_gpu
#PBS -q dgx
#PBS -l select=1:ncpus=10:ngpus=1:mem=16gb
#PBS -l place=free
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -o train_gpu.log

cd "$PBS_O_WORKDIR" || cd "$HOME/explainable-multimodal-HAR"

echo "=========================================================="
echo "Starting Job: $PBS_JOBID on $(hostname) at $(date)"
echo "Working Directory: $(pwd)"
echo "=========================================================="

# 1. Load MANIT CUDA module
module load compilers/nvidia/cuda/11.6 2>/dev/null || true

# 2. Use direct Python interpreter from emit-har environment
PYTHON_BIN="$HOME/.conda/envs/emit-har/bin/python"
if [ ! -f "$PYTHON_BIN" ]; then
    PYTHON_BIN="$(which python)"
fi
echo "Using Python binary: $PYTHON_BIN"

export PYTHONUNBUFFERED=1
mkdir -p experiments/logs experiments/checkpoints experiments/results

# 3. Run Training
$PYTHON_BIN train.py \
    --config configs/config.yaml \
    --model proposed \
    --synthetic \
    --epochs 50 \
    --batch_size 16 \
    --lr 0.0001

echo "Job finished at $(date)"
