#!/bin/bash
# ==============================================================================
# PBS Job Script: 5-Epoch Verification Test Run for Isolated Baseline
# ==============================================================================
#PBS -N emit_iso_test5
#PBS -q dgx
#PBS -l select=1:ncpus=10:ngpus=1:mem=32gb
#PBS -l place=free
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -o test_isolated_5ep.log

cd "$HOME/explainable-multimodal-HAR" || cd "$PBS_O_WORKDIR" || exit 1

LOG_FILE="$HOME/explainable-multimodal-HAR/test_isolated_5ep.log"
exec > >(tee -a "$LOG_FILE") 2>&1

echo "=========================================================="
echo "Starting 5-Epoch Isolated Test Run: $PBS_JOBID on $(hostname) at $(date)"
echo "=========================================================="

# 1. Clean stale collapsed checkpoint directory for fresh start
rm -rf experiments/checkpoints/isolated_seed42

# 2. Setup GPU Environment
module load compilers/nvidia/cuda/11.6 2>/dev/null || true
PYTHON_BIN="$HOME/.conda/envs/emit-har/bin/python"
export PYTHONUNBUFFERED=1

# 3. Launch 5-Epoch Training
$PYTHON_BIN train.py \
    --model isolated \
    --data_dir data/processed_pie \
    --epochs 5 \
    --batch_size 16 \
    --seed 42 \
    --checkpoint_dir experiments/checkpoints/isolated_seed42

echo "5-Epoch test run completed at $(date)"
