#!/bin/bash
# ==============================================================================
# PBS Job Script: Fast Immediate CPU Training on MANIT HPC (short queue)
# ==============================================================================
#PBS -N emit_short
#PBS -q short
#PBS -l select=1:ncpus=10:mem=16gb
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -o train_short.log

cd "$HOME/explainable-multimodal-HAR" || cd "$PBS_O_WORKDIR" || exit 1

LOG_FILE="$HOME/explainable-multimodal-HAR/train_short.log"
exec > >(tee -a "$LOG_FILE") 2>&1

echo "=========================================================="
echo "Starting Fast CPU Job: $PBS_JOBID on $(hostname) at $(date)"
echo "Working Directory: $(pwd)"
echo "=========================================================="

# 1. Maximize CPU Multi-Threading across all 10 allocated cores
export OMP_NUM_THREADS=10
export MKL_NUM_THREADS=10
export PYTHONUNBUFFERED=1

mkdir -p experiments/logs experiments/checkpoints experiments/results

# 2. Use direct Python interpreter from emit-har environment
PYTHON_BIN="$HOME/.conda/envs/emit-har/bin/python"
if [ ! -f "$PYTHON_BIN" ]; then
    PYTHON_BIN="$(which python)"
fi
echo "Using Python binary: $PYTHON_BIN"

# 3. Run Training on 10 Cores
$PYTHON_BIN train.py \
    --config configs/config.yaml \
    --model proposed \
    --synthetic \
    --epochs 50 \
    --batch_size 16 \
    --lr 0.0001

echo "Short queue CPU training completed at $(date)"
