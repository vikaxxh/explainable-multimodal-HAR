#!/bin/bash
# ==============================================================================
# PBS Job Script: Train SOTA IntentFormer Baseline on MANIT HPC (DGX GPU)
# ==============================================================================
#PBS -N emit_train_intentformer
#PBS -q dgx
#PBS -l select=1:ncpus=10:ngpus=1:mem=32gb
#PBS -l place=free
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -o train_intentformer.log

cd "$HOME/explainable-multimodal-HAR" || cd "$PBS_O_WORKDIR" || exit 1

LOG_FILE="$HOME/explainable-multimodal-HAR/train_intentformer.log"
exec > >(tee -a "$LOG_FILE") 2>&1

echo "=========================================================="
echo "Starting IntentFormer Baseline Job: $PBS_JOBID on $(hostname) at $(date)"
echo "Working Directory: $(pwd)"
echo "=========================================================="

# 1. Load MANIT CUDA module
module load compilers/nvidia/cuda/11.6 2>/dev/null || true

# 2. Use direct Python interpreter from emit-har environment
PYTHON_BIN="$HOME/.conda/envs/emit-har/bin/python"
if [ ! -f "$PYTHON_BIN" ]; then
    PYTHON_BIN="$(which python)"
fi
echo "Using Python binary: $PYTHON_BIN"

# Verify Python & GPU availability
$PYTHON_BIN -c "import torch; print(f'PyTorch: {torch.__version__} | CUDA available: {torch.cuda.is_available()} | Device: {torch.cuda.get_device_name(0) if torch.cuda.is_available() else \"None\"}')"

export PYTHONUNBUFFERED=1
mkdir -p experiments/logs experiments/checkpoints/intentformer experiments/results

echo "Sequence count in data/processed/train: $(ls -1 data/processed/train/*.npz 2>/dev/null | wc -l)"

# 3. Run IntentFormer Baseline Training
echo "Starting IntentFormer baseline model training..."
$PYTHON_BIN train.py \
    --config configs/config.yaml \
    --model intentformer \
    --epochs 50 \
    --batch_size 16 \
    --lr 0.0001

echo "IntentFormer baseline training completed successfully at $(date)"
