#!/bin/bash
# ==============================================================================
# PBS Job Script: Check 3B - Zero-Neighbor Counterfactual Ablation on DGX GPU
# ==============================================================================
#PBS -N emit_check3b
#PBS -q dgx
#PBS -l select=1:ncpus=10:ngpus=1:mem=32gb
#PBS -l place=free
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -o eval_check3b.log

cd "$HOME/explainable-multimodal-HAR" || cd "$PBS_O_WORKDIR" || exit 1

LOG_FILE="$HOME/explainable-multimodal-HAR/eval_check3b.log"
exec > >(tee -a "$LOG_FILE") 2>&1

echo "=========================================================="
echo "Starting Check 3B Zero-Neighbor Ablation: $PBS_JOBID on $(hostname) at $(date)"
echo "=========================================================="

module load compilers/nvidia/cuda/11.6 2>/dev/null || true
PYTHON_BIN="$HOME/.conda/envs/emit-har/bin/python"
if [ ! -f "$PYTHON_BIN" ]; then
    PYTHON_BIN="$(which python)"
fi
export PYTHONUNBUFFERED=1

$PYTHON_BIN tools/eval_zero_neighbor_ablation.py \
    --checkpoint experiments/checkpoints/proposed_seed42/checkpoint_best.pt \
    --split val \
    --batch_size 32

echo "Check 3B evaluation completed at $(date)"
