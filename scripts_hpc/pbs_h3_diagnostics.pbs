#!/bin/bash
# ==============================================================================
# PBS Job Script: Run Hypothesis H3 Diagnostics & Mask-All Test on DGX GPU
# ==============================================================================
#PBS -N emit_h3_diag
#PBS -q dgx
#PBS -l select=1:ncpus=10:ngpus=1:mem=32gb
#PBS -l place=free
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -o h3_diagnostics.log

cd "$HOME/explainable-multimodal-HAR" || cd "$PBS_O_WORKDIR" || exit 1

LOG_FILE="$HOME/explainable-multimodal-HAR/h3_diagnostics.log"
exec > >(tee -a "$LOG_FILE") 2>&1

echo "=========================================================="
echo "Starting H3 Diagnostic Suite: $PBS_JOBID on $(hostname) at $(date)"
echo "=========================================================="

module load compilers/nvidia/cuda/11.6 2>/dev/null || true
PYTHON_BIN="$HOME/.conda/envs/emit-har/bin/python"
export PYTHONUNBUFFERED=1

if [ -f "experiments/checkpoints/pie/checkpoint_best.pt" ]; then
    CKPT="experiments/checkpoints/pie/checkpoint_best.pt"
elif [ -f "experiments/checkpoints/checkpoint_best.pt" ]; then
    CKPT="experiments/checkpoints/checkpoint_best.pt"
else
    CKPT="experiments/checkpoints/pie/checkpoint_latest.pt"
fi

echo "Evaluating checkpoint: $CKPT"

$PYTHON_BIN tools/audit_h3_diagnostics.py \
    --checkpoint "$CKPT" \
    --split val \
    --dist_tol 0.15 \
    --speed_tol 0.20 \
    --heading_tol 30.0 \
    --speed_floor 0.002

echo "Diagnostics completed at $(date)"
