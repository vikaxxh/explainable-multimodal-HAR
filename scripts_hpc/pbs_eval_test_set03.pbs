#!/bin/bash
# ==============================================================================
# PBS Job Script: Evaluate Held-Out Test Set 03 (68,060 Sequences, 719 Tracks)
# Un-Quarantines PIE Set 03 and Runs Pre-Registered Hypothesis H2 Empirical Audit
# ==============================================================================
#PBS -N emit_eval_set03
#PBS -q dgx
#PBS -l select=1:ncpus=10:ngpus=1:mem=32gb
#PBS -l place=free
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o eval_test_set03.log

cd "$HOME/explainable-multimodal-HAR" || cd "$PBS_O_WORKDIR" || exit 1

LOG_FILE="$HOME/explainable-multimodal-HAR/eval_test_set03.log"
exec > >(tee -a "$LOG_FILE") 2>&1

echo "=========================================================="
echo "Un-Quarantining PIE Held-Out Test Set 03: $PBS_JOBID on $(hostname) at $(date)"
echo "Working Directory: $(pwd)"
echo "=========================================================="

module load compilers/nvidia/cuda/11.6 2>/dev/null || true
PYTHON_BIN="$HOME/.conda/envs/emit-har/bin/python"
if [ ! -f "$PYTHON_BIN" ]; then
    PYTHON_BIN="$(which python)"
fi
export PYTHONUNBUFFERED=1

# Verify GPU environment
$PYTHON_BIN -c "import torch; print(f'PyTorch: {torch.__version__} | CUDA available: {torch.cuda.is_available()} | Device: {torch.cuda.get_device_name(0) if torch.cuda.is_available() else \"None\"}')"

# 1. Resolve Checkpoints
PROPOSED_CKPT="experiments/checkpoints/pie/checkpoint_best.pt"
if [ ! -f "$PROPOSED_CKPT" ]; then
    PROPOSED_CKPT="experiments/checkpoints/pie_seed42/checkpoint_best.pt"
fi
if [ ! -f "$PROPOSED_CKPT" ]; then
    PROPOSED_CKPT="experiments/checkpoints/proposed_seed42/checkpoint_best.pt"
fi
if [ ! -f "$PROPOSED_CKPT" ]; then
    PROPOSED_CKPT="experiments/checkpoints/checkpoint_best.pt"
fi

ISOLATED_CKPT="experiments/checkpoints/isolated_seed42/checkpoint_best.pt"

echo "Proposed Multi-Agent Checkpoint: $PROPOSED_CKPT"
echo "Fair Isolated Baseline Checkpoint: $ISOLATED_CKPT"

mkdir -p experiments/results

# 2. Run Comprehensive Hypothesis H2 Evaluation on Held-Out Test Set 03
echo -e "\n=========================================================="
echo "EXECUTING TRACK-CLUSTERED BOOTSTRAP HYPOTHESIS H2 ON TEST SET 03"
echo "=========================================================="

$PYTHON_BIN tools/eval_h2_validation_comparison.py \
    --proposed_ckpt "$PROPOSED_CKPT" \
    --isolated_ckpt "$ISOLATED_CKPT" \
    --data_dir data/processed_pie \
    --split test \
    --frozen \
    --batch_size 16 \
    --n_bootstraps 1000 \
    --seed 42 \
    --output_file experiments/results/test_set03_h2_comparison_seed42.npz

echo -e "\nTest Set 03 Evaluation Completed at $(date)"
