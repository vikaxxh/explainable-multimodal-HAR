# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# IDE & OS
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# PyTorch Checkpoints & Large weights
*.pt
*.pth
*.ckpt
*.bin
*.onnx

# Raw video and frame archives
data/raw/*
!data/raw/.gitkeep
data/annotations/*
!data/annotations/.gitkeep
data/splits/*
!data/splits/*/
!data/splits/.gitkeep
!data/splits/**/*.txt

# SSH and local credentials
sshkey/
*.pem
*.key

# Processed sequence datasets (generated .npz/.pt)
data/processed/**/*.npz
data/processed/**/*.pt
!data/processed/**/.gitkeep
data/processed_pie/
data/processed_pie_test/

# Experiment logs and generated outputs
experiments/logs/*
!experiments/logs/.gitkeep
experiments/results/*
!experiments/results/.gitkeep
experiments/checkpoints/*
!experiments/checkpoints/.gitkeep
experiments/configs/*
!experiments/configs/.gitkeep

# Experiment tracking & cache
wandb/
runs/
.cache/
